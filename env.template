# ============================================================================
# Logs Anomaly Detector - Variables de Entorno
# ============================================================================
# INSTRUCCIONES:
# 1. Copiar este archivo como .env: cp env.template .env
# 2. Ajustar los valores según tu entorno
# 3. NUNCA commitear el archivo .env a Git (ya está en .gitignore)
# 4. En producción, cambiar TODAS las contraseñas y secrets

# ============================================================================
# ENTORNO GENERAL
# ============================================================================
ENVIRONMENT=development
NODE_ENV=development
TZ=America/Bogota

# CORS - Orígenes permitidos para la API (separados por coma)
# En producción, especificar dominios reales: https://tudominio.com,https://api.tudominio.com
ALLOWED_ORIGINS=http://localhost:8080,http://localhost

# ============================================================================
# MONGODB - Base de Datos de Logs y Reportes
# ============================================================================
# IMPORTANTE: Cambiar estos valores en producción
# Generar password seguro con: python -c "import secrets; print(secrets.token_urlsafe(16))"
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_mongo_password_production
MONGO_INITDB_DATABASE=logsanomaly
MONGODB_URI=mongodb://admin:CHANGE_ME_mongo_password_production@mongodb:27017/logsanomaly?authSource=admin

# ============================================================================
# POSTGRESQL - Base de Datos de Configuración
# ============================================================================
# IMPORTANTE: Cambiar estos valores en producción
# Generar password seguro con: python -c "import secrets; print(secrets.token_urlsafe(16))"
POSTGRES_DB=logsanomaly
POSTGRES_USER=anomaly_user
POSTGRES_PASSWORD=CHANGE_ME_postgres_password_production
POSTGRES_INITDB_ARGS=--encoding=UTF-8
POSTGRES_DSN=postgresql://anomaly_user:CHANGE_ME_postgres_password_production@postgres:5432/logsanomaly

# ============================================================================
# REDIS - Cache y Colas de Procesamiento
# ============================================================================
REDIS_URL=redis://:redis_change_this_password_in_production@redis:6379/0
REDIS_PASSWORD=redis_change_this_password_in_production

# ============================================================================
# QDRANT - Base de Datos Vectorial para Búsqueda de Similitud
# ============================================================================
# URL del servicio Qdrant (usado para encontrar logs similares)
QDRANT_URL=http://qdrant:6333

# Nombre de la colección para logs normales (para comparación con anomalías)
QDRANT_COLLECTION_NORMAL_LOGS=normal_logs

# Nombre de la colección para anomalías (para agrupación y correlación)
QDRANT_COLLECTION_ANOMALIES=anomalies

# Modelo de embeddings FastEmbed (bge-small-en-v1.5: 384 dims, bge-base-en-v1.5: 768 dims)
FASTEMBED_MODEL=bge-small-en-v1.5

# Tamaño del vector de embeddings (debe coincidir con el modelo: 384 para bge-small, 768 para bge-base)
QDRANT_VECTOR_SIZE=384

# ============================================================================
# BACKEND PYTHON (FastAPI) - Detección de Anomalías
# ============================================================================
PYTHONUNBUFFERED=1

# ============================================================================
# AUTENTICACIÓN JWT - Sistema de Autenticación
# ============================================================================
# SECRET KEY PARA FIRMAR TOKENS JWT - CAMBIAR OBLIGATORIAMENTE EN PRODUCCIÓN
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# El sistema no iniciará si se detecta el valor por defecto en producción
JWT_SECRET_KEY=CHANGE_ME_jwt_secret_key_production_USE_secrets_token_urlsafe

# Algoritmo de encriptación JWT (HS256 recomendado)
JWT_ALGORITHM=HS256

# Tiempo de expiración del token en horas (24 horas por defecto)
JWT_EXPIRATION_HOURS=24

# ============================================================================
# OLLAMA CLOUD - Servicio de IA (usando ollama-client-lib)
# ============================================================================
# API Key de Ollama Cloud (REQUERIDA)
# Obtén tu API key en: https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_cloud_api_key_here

# URL base de Ollama Cloud (default: https://ollama.com)
OLLAMA_URL=https://ollama.com

# Modelo LLM a utilizar (sin sufijo -cloud, se agrega automáticamente)
# Opciones: qwen2.5:3b, phi3:mini, llama3:8b, gemma:7b, kimi-k2:1t, etc.
# Ver modelos disponibles: https://ollama.com/models
MODEL_NAME=qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b

# ============================================================================
# OLLAMA LOCAL (Legacy - para instalaciones locales de Ollama)
# ============================================================================
# URL del servicio Ollama local (solo si usas Ollama local, no Cloud)
# OLLAMA_SERVICE_URL=http://ollama-service:11434

# Host y puerto donde escucha Ollama local
OLLAMA_HOST=0.0.0.0

# Dispositivo: cpu o nvidia (si tienes NVIDIA GPU con CUDA)
OLLAMA_DEVICE=nvidia

# Parámetros avanzados de Ollama (opcionales)
# Temperatura para respuestas (0.0-1.0, más bajo = más determinista)
OLLAMA_TEMPERATURE=0.7

# Top-p sampling (0.0-1.0, controla diversidad)
OLLAMA_TOP_P=0.9

# Máximo de tokens en la respuesta
OLLAMA_MAX_TOKENS=200

# Timeout para peticiones al LLM en segundos
OLLAMA_TIMEOUT=15

# Número de solicitudes paralelas (para procesamiento por lotes)
OLLAMA_NUM_PARALLEL=2

# Máximo de modelos cargados en memoria simultáneamente
OLLAMA_MAX_LOADED_MODELS=1

# Capas de GPU a usar (solo si OLLAMA_DEVICE=nvidia)
OLLAMA_GPU_LAYERS=32

# ============================================================================
# FRONTEND VUE 3 - Aplicación Web
# ============================================================================
# URL base de la API (para peticiones desde el navegador)
VITE_API_URL=http://localhost/api

# Puerto de desarrollo del frontend (solo para desarrollo local)
VITE_PORT=3000

# ============================================================================
# CONFIGURACIONES ADICIONALES (OPCIONAL)
# ============================================================================

# --- Logging ---
LOG_LEVEL=info

# --- Cache de LLM ---
# Tiempo de expiración del cache en segundos (24 horas)
LLM_CACHE_TTL=86400

# --- Análisis de Anomalías ---
# Contamination factor para Isolation Forest (0.01 = 1% de datos son anomalías)
ANOMALY_CONTAMINATION=0.1

# Umbral de similitud para detección de anomalías con embeddings (0.0-1.0)
# Logs con similitud < threshold se consideran anomalías
# Valores más altos = más estricto (más anomalías detectadas)
ANOMALY_SIMILARITY_THRESHOLD=0.4

# Almacenar logs normales en Qdrant para comparación futura (true/false)
STORE_NORMAL_LOGS=true

# --- Reportes ---
# Ruta donde se guardan los reportes generados
REPORTS_PATH=/app/reports

# --- Subida de Archivos ---
# Tamaño máximo de archivo en MB
MAX_FILE_SIZE_MB=50

# ============================================================================
# CONFIGURACIÓN DE RED DOCKER (No modificar normalmente)
# ============================================================================
# Estos valores son usados por docker-compose para configurar la red interna
NETWORK_NAME=logs_analyze_net

# ============================================================================
# NOTAS DE SEGURIDAD
# ============================================================================
# - Cambiar TODAS las contraseñas en producción
# - No exponer puertos de bases de datos externamente
# - Usar HTTPS en producción (configurar certificados SSL en Nginx)
# - Habilitar firewall y rate limiting
# - Configurar backups automáticos de MongoDB y PostgreSQL
# - Rotar credenciales periódicamente

